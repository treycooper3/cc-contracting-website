# C&C portal. Copy to .env.local and fill in. Never commit .env.local.

# Shared Supabase project (same one TnD, FlipBids and Notary Network use).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses RLS, so it must never get a NEXT_PUBLIC_ prefix and must
# never be imported into a client component. Used by /api/leads and /api/calendar,
# which have no user session to act as.
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret the n8n workflow sends as the x-cc-secret header on POST /api/leads.
CC_LEADS_WEBHOOK_SECRET=

# Token on the calendar subscription URL: /api/calendar?token=...
# Rotate this to revoke access for everyone holding the old URL.
CC_CALENDAR_TOKEN=
